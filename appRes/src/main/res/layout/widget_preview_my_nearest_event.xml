<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_preview_card_bg">

    <LinearLayout
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_accent_bar"
        android:backgroundTint="@color/widget_preview_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_preview_header_nearest_event"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_on_surface_variant" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_launcher_monochrome"
                android:tint="@color/widget_preview_on_surface_variant"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_nearest_event_title"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_preview_on_surface" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_nearest_event_days"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/widget_preview_primary" />

            <LinearLayout android:layout_width="4dp" android:layout_height="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/widget_preview_days_away"
                android:textSize="10sp"
                android:textColor="@color/widget_preview_on_surface_variant" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_nearest_event_meta"
                android:textSize="10sp"
                android:textColor="@color/widget_preview_on_surface" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
